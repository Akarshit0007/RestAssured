<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="Smoke Test Suite" verbose="1">
    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke" />
            </run>
        </groups>
        <packages>
            <!-- Scans all test classes in this package for the 'smoke' tag -->
            <package name="com.banking.inc.tests.*" />
        </packages>
    </test>
</suite>